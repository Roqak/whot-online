{
  "name": "lastcard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "preview": "npm run build && npm start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:portal": "tsc --noEmit && VITE_LOCAL_ONLY=1 vite build --outDir dist-portal"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.439.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "three": "^0.169.0",
    "ws": "^8.21.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.5",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
